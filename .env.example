# =========================================================================
# CAREERSETU PLATFORM CONFIGURATION TEMPLATE
# =========================================================================

# --- BACKEND SETTINGS ---
# Environment: development | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database Configuration:
# For local SQLite development (default):
DATABASE_URL=sqlite:///./careersetu.db
# For production PostgreSQL (Render, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Allowed Origins (Comma-separated for production frontend domains):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://careersetu.vercel.app

# Optional AI Provider API Keys (Stored securely on backend):
# Google Gemini (Recommended for deep reasoning):
GEMINI_API_KEY=
# OpenAI (GPT-4o):
OPENAI_API_KEY=
# Groq (Llama-3.3-70b):
GROQ_API_KEY=

# --- FRONTEND SETTINGS (frontend/.env) ---
# For local Vite development, leave empty to use Vite reverse proxy (/api)
# For production Vercel deployment:
# VITE_API_URL=https://careersetu-backend.onrender.com
