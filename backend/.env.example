# CareerSetu Backend Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database: SQLite fallback or Managed PostgreSQL
DATABASE_URL=sqlite:///./careersetu.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Backend Cloud AI Keys (Never commit real keys!)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
